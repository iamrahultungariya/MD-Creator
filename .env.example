# ─────────────────────────────────────────────────────────────────────────────
# MD Writer — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Moderation (Blog, Reviews, Waitlist Panel)
# Comma-separated email addresses with admin access.
VITE_ADMIN_EMAIL=admin@example.com

# Lifetime Pro Accounts
# Comma-separated list of emails that receive permanent Pro access.
# Example: VITE_LIFETIME_PRO_EMAILS=founder@example.com,cofounder@example.com
VITE_LIFETIME_PRO_EMAILS=

# Free Pro Promotion Expiry (ISO 8601 format)
# All authenticated users get Pro free until this date.
# Set to a past date to disable the promotion.
VITE_FREE_PRO_UNTIL=2026-12-31T23:59:59.999Z

# Demo User Display (shown on auth page "Continue as Demo" button)
VITE_DEMO_USER_NAME=Demo User
VITE_DEMO_USER_EMAIL=demo@example.com

